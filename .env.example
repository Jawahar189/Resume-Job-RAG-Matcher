# Copy this file to .env and fill in ONE of the options below.
# With no LLM configured the app still works: it uses keyword extraction + embeddings + templates.

# Option A: OpenAI
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Option B: Groq (free tier) - https://console.groq.com/keys
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Option C: Ollama running locally (free, offline) - `ollama pull llama3.1`
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Optional tuning
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# TOP_K=3
# MATCH_THRESHOLD=0.55
# PARTIAL_THRESHOLD=0.38
